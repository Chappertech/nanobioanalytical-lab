import json
import urllib.parse
import urllib.request
from datetime import datetime, timezone

# ----------------------------------------------------------
# THE CHAPMAN GROUP
# Automatic publication updater
# ----------------------------------------------------------

OPENALEX_AUTHOR_ID = "A5027681613"
START_YEAR = 2022
OUTPUT_FILE = "publications.json"

GOOGLE_SCHOLAR_URL = (
    "https://scholar.google.com.au/"
    "citations?user=3I7cP7YAAAAJ&hl=en"
)

# Publication types that we want to display on the website.
ALLOWED_TYPES = {
    "article",
    "review",
    "book-chapter",
}

# Specific OpenAlex records that should never appear.
# Add another OpenAlex W-number here later if we find an
# incorrectly attributed publication.
EXCLUDED_OPENALEX_IDS = {
    # Unrelated imaging / computer science publication
    "W4387211604",
}

# Titles that OpenAlex may classify as publications but that
# should not be shown on the research-group website.
EXCLUDED_TITLE_PHRASES = {
    "author response",
    "list of contributors",
}


def get_publications():
    """Download publications from OpenAlex."""

    filter_string = (
        f"author.id:{OPENALEX_AUTHOR_ID},"
        f"from_publication_date:{START_YEAR}-01-01"
    )

    params = {
        "filter": filter_string,
        "sort": "publication_date:desc",
        "per-page": 100,
    }

    url = (
        "https://api.openalex.org/works?"
        + urllib.parse.urlencode(params)
    )

    request = urllib.request.Request(
        url,
        headers={
            "User-Agent":
                "Chapman-Group-Publication-Updater/1.0"
        }
    )

    with urllib.request.urlopen(
        request,
        timeout=30
    ) as response:
        data = json.loads(
            response.read().decode("utf-8")
        )

    return data.get("results", [])


def normalise_openalex_id(openalex_id):
    """Return only the W-number from an OpenAlex URL."""

    if not openalex_id:
        return ""

    return openalex_id.rstrip("/").split("/")[-1]


def should_include(work):
    """Decide whether a record belongs on the website."""

    publication_type = work.get("type") or ""

    # Only display selected scholarly output types.
    if publication_type not in ALLOWED_TYPES:
        return False

    # Remove manually excluded records.
    openalex_id = normalise_openalex_id(
        work.get("id")
    )

    if openalex_id in EXCLUDED_OPENALEX_IDS:
        return False

    # Remove unwanted records based on title.
    title = (
        work.get("display_name") or ""
    ).lower()

    for phrase in EXCLUDED_TITLE_PHRASES:
        if phrase in title:
            return False

    return True


def clean_publication(work):
    """Convert OpenAlex information for the website."""

    title = (
        work.get("display_name")
        or "Untitled publication"
    )

    year = work.get("publication_year")
    publication_date = work.get(
        "publication_date"
    )

    authors = []

    for authorship in work.get(
        "authorships", []
    ):
        author = authorship.get(
            "author", {}
        )

        name = author.get("display_name")

        if name:
            authors.append(name)

    primary_location = (
        work.get("primary_location")
        or {}
    )

    source = (
        primary_location.get("source")
        or {}
    )

    journal = (
        source.get("display_name")
        or ""
    )

    doi = work.get("doi")

    if doi:
        doi = doi.replace(
            "https://doi.org/",
            ""
        )

    publication_type = (
        work.get("type")
        or "article"
    )

    type_labels = {
        "article": "Journal Article",
        "review": "Review Article",
        "book-chapter": "Book Chapter",
    }

    type_label = type_labels.get(
        publication_type,
        publication_type.replace(
            "-", " "
        ).title()
    )

    return {
        "title": title,
        "authors": authors,
        "journal": journal,
        "year": year,
        "publication_date":
            publication_date,
        "doi": doi,
        "type": publication_type,
        "type_label": type_label,
        "citations":
            work.get("cited_by_count", 0),
        "openalex": work.get("id"),
    }


def deduplicate(publications):
    """
    Remove duplicate records.

    DOI is used as the primary identifier. If a DOI is
    unavailable, a normalised title is used instead.
    """

    seen = set()
    cleaned = []

    for publication in publications:

        doi = publication.get("doi")

        if doi:
            key = (
                "doi",
                doi.lower().strip()
            )
        else:
            title = (
                publication.get("title")
                or ""
            )

            normalised_title = (
                " ".join(
                    title.lower().split()
                )
            )

            key = (
                "title",
                normalised_title
            )

        if key in seen:
            continue

        seen.add(key)
        cleaned.append(publication)

    return cleaned


def main():

    print(
        "Checking OpenAlex for publications..."
    )

    works = get_publications()

    print(
        f"OpenAlex returned "
        f"{len(works)} records."
    )

    publications = []

    for work in works:

        if not should_include(work):
            continue

        publication = clean_publication(
            work
        )

        if publication["year"]:
            publications.append(
                publication
            )

    publications = deduplicate(
        publications
    )

    publications.sort(
        key=lambda x: (
            x.get("publication_date")
            or "",
            x.get("title")
            or ""
        ),
        reverse=True,
    )

    # Count publications by year.
    years = {}

    for publication in publications:

        year = str(
            publication["year"]
        )

        years[year] = (
            years.get(year, 0) + 1
        )

    output = {
        "author": "James Chapman",
        "openalex_author_id":
            OPENALEX_AUTHOR_ID,
        "google_scholar":
            GOOGLE_SCHOLAR_URL,
        "last_updated":
            datetime.now(
                timezone.utc
            ).isoformat(),
        "publication_count":
            len(publications),
        "publications_by_year":
            years,
        "publications":
            publications,
    }

    with open(
        OUTPUT_FILE,
        "w",
        encoding="utf-8"
    ) as file:

        json.dump(
            output,
            file,
            indent=2,
            ensure_ascii=False
        )

    print(
        f"Finished. Saved "
        f"{len(publications)} clean "
        f"publications to "
        f"{OUTPUT_FILE}."
    )


if __name__ == "__main__":
    main()
